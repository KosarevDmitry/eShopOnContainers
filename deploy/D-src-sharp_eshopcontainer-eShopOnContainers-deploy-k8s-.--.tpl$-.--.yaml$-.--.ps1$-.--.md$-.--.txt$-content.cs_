apiVersion: v1
kind: Service
metadata:
  name: {{ .Values.app.svc.basket }}
  labels:
    app: {{ template "basket-api.name" . }}
    chart: {{ template "basket-api.chart" . }}
    release: {{ .Release.Name }}
    heritage: {{ .Release.Service }}
spec:
