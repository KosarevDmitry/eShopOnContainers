// ### D:\src\sharp_eshopcontainer\eShopOnContainers\deploy\k8s\helm\tls-support\templates\issuer.yaml
apiVersion: cert-manager.io/v1alpha2
kind: Issuer
metadata:
  name: {{ .Values.issuerName }}
  namespace: default
  environment: {{ .Values.environment }}
  app: {{ .Values.applicationName }}
spec:
  acme:
    server: {{ .Values.server }}
    email: not@used.com
    privateKeySecretRef:
      name: {{ .Values.issuerSecretName }}
    solvers:
    - http01:
        ingress:
          class: {{ .Values.ingressClass }}      

// :: there is seem not only values.yaml, but with suffix too
