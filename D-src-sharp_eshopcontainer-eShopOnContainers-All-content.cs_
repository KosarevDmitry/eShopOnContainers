    font-weight: normal;
    font-style: normal;
}

@font-face {
    font-family: 'Oswald';
    src: url('../assets/fonts/Oswald-Bold.eot');
    src: url('../assets/fonts/Oswald-Bold.eot?#iefix') format('embedded-opentype'),
        url('../assets/fonts/Oswald-Bold.woff2') format('woff2'),
