.fr {
    float: right!important;
}

.down-arrow {
    background-image: url('../images/arrow-down.png');
    height: 7px;
    width: 10px;
    display: inline-block;
    margin-left: 20px;
}

.logout-icon {
    background-image: url('../images/logout.PNG');
    display: inline-block;
    height: 19px;
    width: 19px;
    margin-left: 15px;
}

