// ### D:\src\sharp_eshopcontainer\eShopOnContainers\deploy\k8s\helm\webspa\templates\deployment.yaml
{{- $name := include "webspa.fullname" . -}}
{{- $cfgname := printf "%s-%s" "cfg" $name -}}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ template "webspa.fullname" . }}
  labels:
    ufo: {{ $cfgname}}
    app: {{ template "webspa.name" . }}
    chart: {{ template "webspa.chart" . }}
