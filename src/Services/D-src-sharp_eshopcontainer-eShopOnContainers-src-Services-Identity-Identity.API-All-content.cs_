}

h1 {
    font-size: 1.5625rem;
    font-weight: 400;
    text-transform: uppercase;
}

h2 {
    font-size: 1.4375rem;
    font-weight: 400;
    text-transform: uppercase;
}

@media screen and (max-width: 1195px) {
    .cart-product-column-name {
        display: none;
    }
}

/* Hide/rearrange for smaller screens */

@media screen and (max-width: 767px) {
    /* Hide captions */
    .carousel-caption {
        display: none;
    }
    footer .text {
        text-align: left;
        margin-top: -15px;
    }
    .cart-product-column-brand {
        display: none;
    }
}

@media screen and (max-width: 415px) {
    .account-login-container {
        margin-left: -50px;
    }
    .page-consent {
        margin-left: 10px;
        margin-right: 80px;
        padding-right: 0px;
        padding-left: 0px;
    }
}

::selection {
    background: rgba(246, 111, 97, .75);
}


