html, body {
    background-color: #f3f4f3;
    font-family: Oswald, sans-serif;
    font-size: 16px;
    font-weight: normal;
    min-width: 480px;
}

html {
    height: 100%;
}

body {
    display: flex;
    flex-direction: column;
    min-height: 100%;
}

::selection { 
    background: rgba(#f66f61, .75);
}

.mt-15 {
    margin-top: 15px;
}

/* Wrapping element */

/* Set some basic padding to keep content from hitting the edges */

.body-content {
    padding-left: 15px;
    padding-right: 15px;
}

/* Set widths on the form inputs since otherwise they're 100% wide */

.select-filter {
    background-color: transparent;
    padding: 10px;
    margin: 10px;
    margin-right: 20px;
    color: white;
    padding-top: 20px;
    padding-bottom: 3px;
    min-width: 140px;
    border-color: #37c7ca;
    max-height: 43px;
    -webkit-appearance: none;
}

.select-filter option {
    background-color: #00a69c;
}

select::-ms-expand {
    display: none;
}

.select-filter-wrapper {
    z-index: 0;
    display: inline-block;
    margin-left: -10px;
}

.select-filter-wrapper::before {
    content: attr(data-name);
    opacity: 0.5;
    z-index: 1;
    text-transform: uppercase;
    position: absolute;
    font-size: 10px;
    margin-top: 15px;
    margin-left: 21px;
    color: white;
}

.select-filter-arrow {
    position: absolute;
    margin-left: 130px;
