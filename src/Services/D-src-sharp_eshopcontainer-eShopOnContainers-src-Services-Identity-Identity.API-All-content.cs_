}

/* buttons and links extension to use brackets: [ click me ] */

.btn-bracketed:hover:before {
    display: inline-block;
    content: "[";
    padding-right: 0.5em;
    color: chartreuse;
}

.btn-bracketed:hover:after {
    display: inline-block;
    content: "]";
    padding-left: 0.5em;
