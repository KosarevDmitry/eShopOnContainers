.next {
    position: absolute;
    right: 15px;
    top: 0;
}

.previous {
    position: absolute;
    left: 0;
    top: 0;
}

.is-disabled {
    cursor: not-allowed;
    opacity: .5;
    pointer-events: none;
}

.table tr {
