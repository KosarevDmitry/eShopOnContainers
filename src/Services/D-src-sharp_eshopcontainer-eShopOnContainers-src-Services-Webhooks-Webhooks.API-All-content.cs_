    build:
      useGitIgnore: true
      dockerfile: Dockerfile.develop
    container:
      syncTarget: /src
      sync:
      - '**/Pages/**'
      - '**/Views/**'
      - '**/wwwroot/**'
      - '!**/*.{sln,csproj}'
