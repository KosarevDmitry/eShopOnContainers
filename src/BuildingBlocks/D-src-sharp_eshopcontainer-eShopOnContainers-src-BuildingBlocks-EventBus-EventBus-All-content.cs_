namespace Microsoft.eShopOnContainers.BuildingBlocks.EventBus.Events;

public record IntegrationEvent
{        
    public IntegrationEvent()
    {
        Id = Guid.NewGuid();
        CreationDate = DateTime.UtcNow;
    }

    [JsonConstructor] // :: нужно посмотреть что какие аттрибуты еще есть
    public IntegrationEvent(Guid id, DateTime createDate)
    {
        Id = id;
        CreationDate = createDate;
    }

    [JsonInclude]
    public Guid Id { get; private init; }

    [JsonInclude]
    public DateTime CreationDate { get; private init; }
}


// ### D:\src\sharp_eshopcontainer\eShopOnContainers\src\BuildingBlocks\EventBus\EventBus\Extensions\GenericTypeExtensions.cs
using System.Diagnostics;
// :: fine way to get readable standart generic name, probably fo logging
namespace Microsoft.eShopOnContainers.BuildingBlocks.EventBus.Extensions;
public static class GenericTypeExtensions
{
    public static string GetGenericTypeName(this Type type)
    {
        string typeName;

        if (type.IsGenericType)
        {
           var genericTypes = string.Join(",", type.GetGenericArguments().Select(t => t.Name).ToArray());
            typeName = $"{type.Name.Remove(type.Name.IndexOf('`'))}<{genericTypes}>";
        }
        else
        {
            typeName = type.Name;
        }

        return typeName;
    }

    public static string GetGenericTypeName(this object @object)
    {
        return @object.GetType().GetGenericTypeName();
    }
}


