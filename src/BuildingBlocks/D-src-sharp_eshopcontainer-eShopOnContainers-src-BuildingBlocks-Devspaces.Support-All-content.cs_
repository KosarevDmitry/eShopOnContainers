// ### D:\src\sharp_eshopcontainer\eShopOnContainers\src\BuildingBlocks\Devspaces.Support\HttpClientBuilderDevspacesExtensions.cs
namespace Devspaces.Support;

public static class HttpClientBuilderDevspacesExtensions
{
    public static IHttpClientBuilder AddDevspacesSupport(this IHttpClientBuilder builder)
    {
        builder.AddHttpMessageHandler<DevspacesMessageHandler>();
        return builder;
    }
}


// ### D:\src\sharp_eshopcontainer\eShopOnContainers\src\BuildingBlocks\Devspaces.Support\readme.md
Хороший пример с точки зрения устройства сервисов
каждый класс должен быть добавлен  в коллекцию сервисов
это естественный способ его создания
потом передавай куда уже требуется
`services.AddTransient<DevspacesMessageHandler>();`

`builder.AddHttpMessageHandler<DevspacesMessageHandler>();`

проект демонстрирует как добавить
подключить обработчик сообщения DelegatingHandler


// ### D:\src\sharp_eshopcontainer\eShopOnContainers\src\BuildingBlocks\Devspaces.Support\ServiceCollectionDevspacesExtensions.cs
namespace Devspaces.Support;

public static class ServiceCollectionDevspacesExtensions
{
    public static IServiceCollection AddDevspaces(this IServiceCollection services)
    {
        services.AddTransient<DevspacesMessageHandler>();
        return services;
    }
}


