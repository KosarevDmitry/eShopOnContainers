    <p>(Data since last time web started up). <strong>Note: </strong>Must manually refresh this page.<p>
    <table class="table">
        @foreach (var webhook in Model.WebHooksReceived)
        {
            <tr>
                <td>@webhook.When</td>
                <td><pre>@webhook.Data</pre></td>
                <td>@(webhook.Token ?? "--None--")</td>
            </tr>
        }
    </table>
</div>



